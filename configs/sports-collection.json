{
  "version": "sports-shadow-v1",
  "parser_version": "sports-odds-v4",
  "program_parser_version": "sports-program-v3",
  "result_parser_version": "sports-result-v1",
  "interval_seconds": 120,
  "request_spacing_seconds": 5,
  "request_timeout_seconds": 20,
  "maximum_parallel_requests": 4,
  "alarm_budget_seconds": 30,
  "capture_window_seconds": 90,
  "maximum_raw_bytes": 2097152,
  "maximum_plan_entries": 64,
  "maximum_pending_requests": 256,
  "maximum_history_rows": 100,
  "sources": {
    "boat": {
      "origin": "https://www.boatrace.jp",
      "catalog_path": "/owpc/pc/race/index",
      "program_path": "/owpc/pc/race/raceindex",
      "result_path": "/owpc/pc/race/raceresult",
      "odds_pages": [
        {"path": "/owpc/pc/race/odds3t", "market": "trifecta"},
        {"path": "/owpc/pc/race/odds3f", "market": "trio"},
        {"path": "/owpc/pc/race/odds2tf", "market": null},
        {"path": "/owpc/pc/race/oddsk", "market": "wide"},
        {"path": "/owpc/pc/race/oddstf", "market": null}
      ],
      "paths": [
        "/owpc/pc/race/index",
        "/owpc/pc/race/raceindex",
        "/owpc/pc/race/odds3t",
        "/owpc/pc/race/odds3f",
        "/owpc/pc/race/odds2tf",
        "/owpc/pc/race/oddsk",
        "/owpc/pc/race/oddstf",
        "/owpc/pc/race/raceresult"
      ]
    },
    "keirin": {
      "origin": "https://keirin.jp",
      "guest_path": "/pc/top",
      "live_path": "/pc/racelive",
      "json_path": "/pc/json",
      "catalog_json_type": "JSJ048",
      "result_json_type": "JSJ012",
      "identity_json_type": "JST015",
      "paths": [
        "/pc/top",
        "/pc/json",
        "/pc/racelive"
      ],
      "read_json_types": [
        "JSJ048",
        "JSJ001",
        "JST015",
        "JST010",
        "JST011",
        "JSJ012"
      ],
      "maximum_entrant_number": 9,
      "maximum_frame_number": 6,
      "frame_markets_enabled_label": "1",
      "frame_markets_disabled_label": "0",
      "runners_media_flag": "1",
      "odds_json_type": "JST011",
      "odds_market_codes": {"trifecta": "6", "exacta": "2", "trio": "7", "quinella": "4", "frame_exacta": "3", "frame_quinella": "1", "wide": "5"}
    },
    "auto": {
      "origin": "https://autorace.jp",
      "catalog_path": "/race_info/XML/Hold/Today",
      "program_path": "/race_info/OtherRaceInfo",
      "odds_path": "/race_info/Odds",
      "result_path": "/race_info/RaceResult",
      "paths": [
        "/race_info/XML/Hold/Today",
        "/race_info/Odds",
        "/race_info/OtherRaceInfo",
        "/race_info/RaceResult"
      ],
      "guest_pages": [
        "/race_info/Live/kawaguchi",
        "/race_info/Live/isesaki",
        "/race_info/Live/hamamatsu",
        "/race_info/Live/iizuka",
        "/race_info/Live/sanyou"
      ]
    }
  },
  "plan_horizon_seconds": 86400,
  "guest_session_seconds": 1800,
  "daily": {
    "start_hour": 7,
    "end_hour": 30,
    "rollover_hour": 6,
    "catalog_interval_seconds": 600,
    "program_interval_seconds": 300,
    "guest_interval_seconds": 900,
    "odds_lead_seconds": 3600,
    "result_delay_seconds": 120,
    "result_interval_seconds": 300,
    "result_window_seconds": 3600,
    "final_odds_delay_seconds": 120,
    "final_odds_interval_seconds": 300,
    "final_odds_window_seconds": 3600,
    "deferred_interval_seconds": 120,
    "blocked_interval_seconds": 600,
    "planning_offset_seconds": 1,
    "maximum_tasks": 1024
  },
  "discovery": {
    "maximum_program_age_seconds": 600,
    "clock_timezone_offset_minutes": 540,
    "maximum_clock_hour": 29,
    "maximum_race_number": 99,
    "maximum_venue_number": 99
