{
  "name": "hr-platform-collector",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typegen": "wrangler types --strict-vars false",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/runtime/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir private/worker-build",
    "build:sports": "wrangler deploy --dry-run --config wrangler.sports.jsonc --outdir private/sports-worker-build"
  },
  "devDependencies": {
    "wrangler": "4.142.0",
    "miniflare": "5.20260926.0-alpha",
    "typescript": "5.9.3",
    "esbuild": "0.25.10"
  }
}
