{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hr-platform-dev-archive",
  "account_id": "11233bca08d134a9b738eaa46b9751d9",
  "main": "workers/archive/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "limits": {
    "cpu_ms": 10000
  },
  "vars": {
    "ARCHIVE_ENABLED": "true",
    "BACKFILL_DAYS": "7305",
    "ARCHIVE_MIN_INTERVAL_MS": "60000",
    "ARCHIVE_SLOT_WINDOW_MS": "120000",
    "ARCHIVE_REQUEST_TIMEOUT_MS": "30000",
    "ARCHIVE_REQUEST_LEASE_MS": "180000",
    "ARCHIVE_RETRY_WAIT_MS": "120000",
    "ARCHIVE_MAX_BODY_BYTES": "16777216",
    "ARCHIVE_DISPLAY_TIMES": "24",
    "ARCHIVE_MAX_PAGES": "201"
  },
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "hr-platform-dev-index",
      "database_id": "81fc8e82-cb25-4baa-834d-b69a8f2ac977",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "hr-platform-dev-private"
    }
  ]
}
