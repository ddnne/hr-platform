{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "hr-platform-dev-sports", "main": "workers/sports/index.ts",
 "compatibility_date": "2026-09-28", "compatibility_flags": ["nodejs_compat"],
 "workers_dev": false, "preview_urls": false, "triggers": {"crons": []},
 "vars": {"SPORTS_ENABLED": "false", "SPORTS_PROVIDERS_JSON": "[]"},
 "d1_databases": [{"binding": "INDEX", "database_name": "hr-platform-dev-index", "database_id": "81fc8e82-cb25-4baa-834d-b69a8f2ac977", "migrations_dir": "migrations"}],
 "r2_buckets": [{"binding": "RAW", "bucket_name": "hr-platform-dev-private"}],
 "durable_objects": {"bindings": [{"name": "SPORTS", "class_name": "SportsCollector"}]},
 "migrations": [{"tag": "sports-collector-v1", "new_sqlite_classes": ["SportsCollector"]}]
}
